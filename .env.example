# Database
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/airquality_dev"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Data Providers
# Register at https://data.gov.in/ for API access
DATA_GOV_IN_API_KEY="your_data_gov_in_api_key_here"

# OpenAQ API (Optional - no key required for basic usage)
# Register at https://openaq.org/ for higher rate limits
OPENAQ_API_KEY=""

# Weather Provider
# Register at https://openweathermap.org/api for free tier
OPENWEATHER_API_KEY="your_openweathermap_api_key_here"

# AI Provider
# Choose ONE of the following:

# Option 1: OpenAI (GPT-4)
# Register at https://platform.openai.com/
OPENAI_API_KEY="sk-your_openai_api_key_here"

# Option 2: Anthropic (Claude)
# Register at https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key_here"

# AI Provider Selection
# Options: "openai" | "anthropic"
AI_PROVIDER="openai"

# Rate Limiting (Optional)
# Customize rate limits if needed
# RATE_LIMIT_AQI_CURRENT="60"  # requests per minute
# RATE_LIMIT_AQI_HISTORY="30"
# RATE_LIMIT_ASSISTANT="10"

# Logging (Optional)
# LOG_LEVEL="info"  # error | warn | info | debug
